# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# AI providers — server only unless explicitly marked NEXT_PUBLIC
# Required text-task chain, tried in this order: Groq -> Cerebras -> OpenRouter -> optional Claude
GROQ_API_KEY=
GROQ_MODELS=openai/gpt-oss-120b
CEREBRAS_API_KEY=
CEREBRAS_MODELS=gpt-oss-120b
OPENROUTER_API_KEY=
OPENROUTER_MODELS=meta-llama/llama-3.3-70b-instruct
# Optional — last resort in the chain, and a vision fallback for Product Identity analysis
ANTHROPIC_API_KEY=
ANTHROPIC_MODELS=claude-haiku-4-5-20251001
# Existing providers — Gemini is an extra fallback beyond the required chain
# (and the primary vision provider for Product Identity), Fal is image/video generation
GEMINI_API_KEY=
FAL_KEY=
# Optional: comma-separated model preference overrides
PICBO_GEMINI_MODELS=gemini-2.5-flash-lite,gemini-2.5-flash
PICBO_FAL_IMAGE_MODEL=fal-ai/flux/schnell
PICBO_MAX_RETRIES=2
PICBO_JOB_TIMEOUT_MS=120000

# Billing (Paddle) — leave unset to keep Billing in its honest
# "not connected" state; nothing fakes a successful payment either way
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_PRICE_STARTER_MONTHLY=
PADDLE_PRICE_STARTER_ANNUAL=
PADDLE_PRICE_PRO_MONTHLY=
PADDLE_PRICE_PRO_ANNUAL=
PADDLE_PRICE_AGENCY_MONTHLY=
PADDLE_PRICE_AGENCY_ANNUAL=

# Integrations — OAuth credentials per provider. Generate the encryption key
# with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
INTEGRATIONS_ENCRYPTION_KEY=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
META_APP_ID=
META_APP_SECRET=

# Render worker — a real FFmpeg worker (container/service, not this Next.js
# app) calls back into /api/render-worker/{complete,fail} with this shared
# secret. /api/render-worker/sweep should be hit periodically (cron) to
# dead-letter + refund jobs no worker ever claimed.
RENDER_WORKER_SECRET=
RENDER_QUEUE_TIMEOUT_MS=900000
